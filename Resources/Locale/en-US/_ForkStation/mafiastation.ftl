mafiastation-title = Mafiastation
mafiastation-description = Trust no one. Someone aboard may not be who they say they are — or the station itself may turn on you. The lights have been acting strange lately.

# Phantom announcements — official-sounding, subtly wrong.
mafiastation-phantom-sender = Central Command
mafiastation-phantom-1 = Arrivals shuttle docking complete. Passenger manifest: one. Please extend a warm welcome.
mafiastation-phantom-2 = Reminder: maintenance tunnels are off-limits during unscheduled hours. Disregard any voices requesting assistance.
mafiastation-phantom-3 = Atmospherics report: carbon dioxide levels consistent with current crew complement, plus one.
mafiastation-phantom-4 = Scheduled announcement: there is no scheduled announcement at this time. We apologize for the confusion.
mafiastation-phantom-5 = Crew advisory: if you encounter yourself in the halls, do not engage. Report to the nearest security officer.
mafiastation-phantom-6 = This announcement has been played in error. Please continue as normal.
mafiastation-phantom-crewcount = Routine census complete. Current shift crew count: {$count}. Thank you for your cooperation.

# Whispers nobody sent.
mafiastation-whisper-1 = ...behind you...
mafiastation-whisper-2 = ...it's so cold in the walls...
mafiastation-whisper-3 = ...don't turn around...
mafiastation-whisper-4 = ...we can see you...
mafiastation-whisper-5 = ...the lights lie...
mafiastation-whisper-name = ...{$name}... {$name}... come find us...
